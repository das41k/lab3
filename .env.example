# ─────────────────────────────────────────────────────────────────────────────
# Пример конфигурации Banking Protocol (ЛР3).
#
# Скопируйте файл в .env и сгенерируйте настоящий ключ:
#     uv run python scripts/generate_key.py
#
# .env НЕ коммитится в Git (см. .gitignore). Настоящий ключ хранится только
# в локальном .env или в keys/keyring.json (тоже исключён из Git).
# ─────────────────────────────────────────────────────────────────────────────

# Сетевые параметры
APP_HOST=127.0.0.1
APP_PORT=65432

# Идентификатор текущей версии ключа (key rotation)
APP_KEY_ID=key-2026-01

# AES-256 ключ: base64 от 32 случайных байт.
# Значение-заглушка; замените его через scripts/generate_key.py.
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Локальное хранилище «выведенных из эксплуатации» ключей (не коммитится)
APP_KEYRING_FILE=keys/keyring.json

# Защита от слишком больших входящих сообщений (байт)
APP_MAX_MESSAGE_BYTES=65536

# Таймауты и ретраи клиента (секунды)
APP_TIMEOUT_SECONDS=5
APP_MAX_RETRIES=3

# Контроль повторного использования nonce (учебное требование ЛР3)
APP_STRICT_NONCE_CHECK=true

# Задержка тестового обработчика SLOW_TEST (секунды)
APP_SLOW_TEST_SECONDS=30

# Каталог журналов
APP_LOG_DIR=logs
